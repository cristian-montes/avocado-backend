MODEL_GCS_URI=gs://your-private-bucket/models/model-v1/model_state_dict.pth
MODEL_SHA256=c3519cb25d54e4b4f72e81b26090db29f5e476ef80cf34bd0d28ff563e0d9960

# Upload limits
MAX_UPLOAD_BYTES=10485760
